---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
import TeamStandingsGrid from "../../components/Results/TeamStandingsGrid.astro";
import { getCollection } from "astro:content";

// All seasons of team standings (legacy club-grid format), newest first → year tabs.
const seasons = (await getCollection("teamResults"))
  .map(e => e.data)
  .filter(d => d.series === "Enduro")
  .sort((a, b) => b.year - a.year);

const clubs = await getCollection("clubs");
const clubNameMap = Object.fromEntries(
  clubs.map(c => [c.data.abbreviatedName, c.data.name])
);
const clubSlugMap = Object.fromEntries(
  clubs.map(c => [c.data.abbreviatedName, c.slug])
);

const formatLongDate = (dateStr: string) =>
  new Date(dateStr + "T12:00:00").toLocaleDateString("en-US", {
    month: "long", day: "numeric", year: "numeric",
  });

const pointsScale = [
  { place: 1, points: 25 }, { place: 2, points: 22 }, { place: 3, points: 20 },
  { place: 4, points: 18 }, { place: 5, points: 16 }, { place: 6, points: 15 },
  { place: 7, points: 14 }, { place: 8, points: 13 }, { place: 9, points: 12 },
  { place: 10, points: 11 },
];
---

<BaseLayout
  title="Team Results - ECEA"
  description="ECEA Enduro Series Club Team Competition results and standings."
>
  <PageHeader
    title="Team Competition"
    subtitle="ECEA Enduro Series Club Team Results"
    backgroundImage="/images/feature-bg.jpg"
  />

  <section class="py-12">
    <div class="container">
      {seasons.length > 0 ? (
        <div class="space-y-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <!-- Year tabs -->
            <div class="flex flex-wrap gap-2" role="tablist" aria-label="Season">
              {seasons.map((s, i) => (
                <button
                  type="button"
                  data-year-tab={s.year}
                  class:list={[
                    "year-tab px-4 py-2 rounded-lg font-semibold text-sm transition-colors",
                    i === 0 ? "bg-amber-500 text-white" : "bg-gray-100 text-gray-700 hover:bg-gray-200",
                  ]}
                >
                  {s.year}
                </button>
              ))}
            </div>
            <a href="/results/individual" class="inline-flex items-center text-primary-600 hover:text-primary-700 font-medium text-sm">
              Individual standings
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

          {seasons.map((s, i) => (
            <div data-year-panel={s.year} hidden={i !== 0} class="space-y-4">
              <div>
                <h2 class="text-2xl font-bold text-gray-900">{s.year} {s.series} — Final Standings</h2>
                <p class="text-gray-600 text-sm mt-1">Official &middot; {formatLongDate(s.lastUpdated)}</p>
              </div>

              <TeamStandingsGrid
                events={s.events}
                standings={s.standings}
                clubNameMap={clubNameMap}
                clubSlugMap={clubSlugMap}
              />
            </div>
          ))}

          <!-- Legend -->
          <div class="flex flex-wrap gap-4 text-sm text-gray-600">
            <div class="flex items-center gap-2">
              <span class="px-1.5 py-0.5 bg-amber-100 text-amber-700 rounded text-xs font-medium">H</span>
              <span>Host Club (teams get 0 championship points)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-gray-300">—</span>
              <span>No finishing teams / round not held</span>
            </div>
            <div class="text-gray-500">Scores reflect best team per club per event. All events count — no throw-aways.</div>
          </div>

          <!-- Points Scale -->
          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="font-bold text-gray-900 mb-4">Points Scale</h3>
            <div class="flex flex-wrap gap-3">
              {pointsScale.map(({ place, points }) => (
                <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded border">
                  <span class="text-sm text-gray-600">{place}{place === 1 ? 'st' : place === 2 ? 'nd' : place === 3 ? 'rd' : 'th'}</span>
                  <span class="font-bold text-primary-700">{points}</span>
                </div>
              ))}
              <span class="text-sm text-gray-500 self-center">... down to 20th = 1 point</span>
            </div>
          </div>
        </div>
      ) : (
        <p class="text-gray-500 italic">Team standings are not available yet.</p>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-year-tab]");
  const panels = document.querySelectorAll<HTMLElement>("[data-year-panel]");
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const year = tab.getAttribute("data-year-tab");
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle("bg-amber-500", active);
        t.classList.toggle("text-white", active);
        t.classList.toggle("bg-gray-100", !active);
        t.classList.toggle("text-gray-700", !active);
      });
      panels.forEach((p) => {
        p.hidden = p.getAttribute("data-year-panel") !== year;
      });
    });
  });
</script>
