---
/**
 * SponsorCarousel Component
 * Displays title sponsor prominently and scrolling carousel of other sponsors
 */
import { Image } from "astro:assets";
import { getCmsImage } from "../../utils/cmsImage";

interface Sponsor {
  name: string;
  logo: string;
  url: string;
}

interface Props {
  titleSponsor?: Sponsor | null;
  sponsors: Sponsor[];
}

const { titleSponsor, sponsors } = Astro.props;
---

<section class="py-8 bg-gray-50 overflow-hidden">
  <div class="container">
    <!-- Title + Title Sponsor inline -->
    <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-8 mb-6">
      <div class="text-center md:text-left">
        <span class="text-primary-600 font-medium text-sm uppercase tracking-wider">Proudly Supported By</span>
        <h2 class="text-xl md:text-2xl font-bold">Our Sponsors</h2>
      </div>
      {titleSponsor && (
        <>
          <div class="hidden md:block w-px h-12 bg-gray-300"></div>
          <a
            href={titleSponsor.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3"
          >
            <span class="text-xs uppercase tracking-wider text-gray-500">Title Sponsor</span>
            <div class="bg-white rounded-lg px-4 py-2 border border-gray-200 group-hover:border-primary-300 transition-colors">
              {getCmsImage(titleSponsor.logo) ? (
                <Image
                  src={getCmsImage(titleSponsor.logo)!}
                  alt={titleSponsor.name}
                  class="h-10 md:h-12 w-auto object-contain"
                />
              ) : (
                <img src={titleSponsor.logo} alt={titleSponsor.name} loading="lazy" class="h-10 md:h-12 w-auto object-contain" />
              )}
            </div>
          </a>
        </>
      )}
    </div>

    <!-- Sponsor Carousel -->
    <div class="relative">
      <div class="sponsor-carousel flex items-center">
        {[...sponsors, ...sponsors].map((sponsor, i) => {
          // The list is duplicated to create a seamless loop; the second copy
          // is purely visual, so hide it from assistive tech and keyboard order.
          const isDuplicate = i >= sponsors.length;
          return (
            <a
              href={sponsor.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-shrink-0 mr-8 md:mr-12"
              aria-hidden={isDuplicate ? "true" : undefined}
              tabindex={isDuplicate ? -1 : undefined}
            >
              {getCmsImage(sponsor.logo) ? (
                <Image
                  src={getCmsImage(sponsor.logo)!}
                  alt={sponsor.name}
                  class="h-8 md:h-10 w-auto object-contain"
                />
              ) : (
                <img src={sponsor.logo} alt={sponsor.name} loading="lazy" class="h-8 md:h-10 w-auto object-contain" />
              )}
            </a>
          );
        })}
      </div>

      <!-- Pause/play control: gives everyone (not just hover) a way to stop the motion (WCAG 2.2.2) -->
      <button
        type="button"
        data-sponsor-pause
        aria-pressed="false"
        class="sponsor-pause absolute top-1/2 right-0 -translate-y-1/2 z-10 grid place-items-center w-9 h-9 rounded-full bg-white border border-gray-200 text-gray-600 shadow-sm hover:text-primary-600 hover:border-primary-300 focus-visible:ring-2 focus-visible:ring-primary-600 transition-colors"
      >
        <span class="sr-only" data-sponsor-pause-label>Pause sponsor scrolling</span>
        <svg data-icon="pause" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="6" y="5" width="4" height="14" rx="1"></rect>
          <rect x="14" y="5" width="4" height="14" rx="1"></rect>
        </svg>
        <svg data-icon="play" class="h-4 w-4 hidden" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .sponsor-carousel {
    animation: scroll 30s linear infinite;
    width: max-content;
  }
  /* Pause on hover, on keyboard focus within the track, and on explicit request */
  .sponsor-carousel:hover,
  .sponsor-carousel:focus-within,
  .sponsor-carousel.is-paused {
    animation-play-state: paused;
  }
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  /* Mobile: faster than desktop */
  @media (max-width: 768px) {
    .sponsor-carousel {
      animation-duration: 20s;
    }
  }
  /* Respect users who prefer reduced motion: stop entirely, hide the toggle */
  @media (prefers-reduced-motion: reduce) {
    .sponsor-carousel {
      animation: none;
    }
    .sponsor-pause {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-sponsor-pause]").forEach((btn) => {
    const track = btn.parentElement?.querySelector(".sponsor-carousel");
    const label = btn.querySelector("[data-sponsor-pause-label]");
    const pauseIcon = btn.querySelector('[data-icon="pause"]');
    const playIcon = btn.querySelector('[data-icon="play"]');
    if (!track) return;

    btn.addEventListener("click", () => {
      const paused = track.classList.toggle("is-paused");
      btn.setAttribute("aria-pressed", String(paused));
      if (label) label.textContent = paused ? "Resume sponsor scrolling" : "Pause sponsor scrolling";
      pauseIcon?.classList.toggle("hidden", paused);
      playIcon?.classList.toggle("hidden", !paused);
    });
  });
</script>
