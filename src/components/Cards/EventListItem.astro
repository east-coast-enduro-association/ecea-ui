---
/**
 * EventListItem Component
 * Compact, dated list row for an event. Used in the homepage "Upcoming Events"
 * rail beside Latest News, where a dense scannable list reads better than image
 * tiles and degrades gracefully when there are only a few events.
 */
import { formatDate } from "../../utils/dateUtils";
import { getEventTypeBadgeClasses } from "../../utils/eventTypeColors";

interface Props {
  title: string;
  slug: string;
  date: Date;
  eventType?: string;
  location?: string;
}

const { title, slug, date, eventType, location } = Astro.props;
---

<a
  href={`/events/${slug}`}
  class="group flex items-center gap-4 p-3 md:p-4 hover:bg-gray-50 transition-colors"
>
  <div class="flex-shrink-0 w-12 text-center">
    <div class="text-xs font-semibold uppercase tracking-wider text-primary-600">
      {formatDate(date, "MMM")}
    </div>
    <div class="text-2xl font-bold leading-none text-gray-900">
      {formatDate(date, "d")}
    </div>
  </div>

  <div class="min-w-0 flex-1">
    {eventType && (
      <span class={`inline-block px-2 py-0.5 rounded text-xs font-medium mb-1 ${getEventTypeBadgeClasses(eventType)}`}>
        {eventType}
      </span>
    )}
    <h3 class="font-semibold text-gray-900 group-hover:text-primary-600 transition-colors truncate">
      {title}
    </h3>
    {location && <p class="text-sm text-gray-500 truncate">{location}</p>}
  </div>

  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 text-gray-300 group-hover:text-primary-600 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
  </svg>
</a>
