---
/**
 * EventListItem Component
 * Compact, dated list row for an event. Used in the homepage "Upcoming Events"
 * rail beside Latest News, where a dense scannable list reads better than image
 * tiles and degrades gracefully when there are only a few events.
 *
 * Interaction: the whole row is a stretched link to the event page; an expand
 * button layered on top toggles an inline details panel (summary, check-in,
 * gate fee, host club, actions) without navigating. Click-based, so it works
 * on touch as well as hover/keyboard.
 */
import { Image } from "astro:assets";
import { formatDate } from "../../utils/dateUtils";
import { getEventTypeBadgeClasses } from "../../utils/eventTypeColors";
import { getCmsImage } from "../../utils/cmsImage";

interface Props {
  title: string;
  slug: string;
  date: Date;
  eventType?: string;
  location?: string;
  clubLogo?: string;
  clubName?: string;
  summary?: string;
  checkInTime?: string;
  gateFee?: string;
  registrationLink?: string;
}

const {
  title,
  slug,
  date,
  eventType,
  location,
  clubLogo,
  clubName,
  summary,
  checkInTime,
  gateFee,
  registrationLink,
} = Astro.props;

const logoMeta = getCmsImage(clubLogo);
const detailsId = `event-details-${slug}`;
---

<div class="group">
  <div class="relative flex items-center gap-3 p-3 md:p-4">
    <!-- Stretched link: a click anywhere on the row (except the expand button) navigates -->
    <a href={`/events/${slug}`} class="absolute inset-0 z-0" aria-label={`View ${title}`}></a>

    <div class="flex-shrink-0 w-10 text-center">
      <div class="text-xs font-semibold uppercase tracking-wider text-primary-600">
        {formatDate(date, "MMM")}
      </div>
      <div class="text-2xl font-bold leading-none text-gray-900">
        {formatDate(date, "d")}
      </div>
    </div>

    {logoMeta && (
      <div class="flex-shrink-0 w-10 h-10 rounded-md bg-white border border-gray-100 flex items-center justify-center p-1">
        <Image src={logoMeta} alt={clubName ? `${clubName} logo` : "Host club logo"} class="max-w-full max-h-full w-auto h-auto object-contain" />
      </div>
    )}

    <div class="min-w-0 flex-1">
      {eventType && (
        <span class={`inline-block px-2 py-0.5 rounded text-xs font-medium mb-1 ${getEventTypeBadgeClasses(eventType)}`}>
          {eventType}
        </span>
      )}
      <h3 class="event-title font-semibold text-gray-900 group-hover:text-primary-600 transition-colors truncate">
        {title}
      </h3>
      {location && <p class="event-loc text-sm text-gray-500 truncate">{location}</p>}
    </div>

    <!-- Expand toggle sits above the stretched link (z-10) so it captures its own clicks -->
    <button
      type="button"
      data-event-expand
      aria-expanded="false"
      aria-controls={detailsId}
      aria-label={`Show details for ${title}`}
      class="event-expand relative z-10 flex-shrink-0 grid place-items-center w-8 h-8 rounded-full text-gray-400 hover:bg-gray-100 hover:text-primary-600 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="event-expand-icon h-5 w-5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
  </div>

  <!-- Inline expanded details -->
  <div id={detailsId} hidden class="px-3 md:px-4 pb-4 -mt-1 text-sm text-gray-600">
    {summary && <p class="mb-2">{summary}</p>}
    <div class="flex flex-wrap gap-x-4 gap-y-1 text-gray-500">
      <span class="font-medium text-gray-700">{formatDate(date, "EEEE, MMMM d")}</span>
      {checkInTime && <span>Check-in {checkInTime}</span>}
      {gateFee && <span>Gate {gateFee}</span>}
      {clubName && <span>Host: {clubName}</span>}
    </div>
    <div class="flex flex-wrap gap-2 mt-3">
      <a
        href={`/events/${slug}`}
        class="inline-flex items-center px-3 py-1.5 rounded-lg bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors"
      >
        Event details
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      {registrationLink && (
        <a
          href={registrationLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-3 py-1.5 rounded-lg bg-white border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50 transition-colors"
        >
          Register
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .event-expand[aria-expanded="true"] .event-expand-icon {
    transform: rotate(180deg);
  }
  /* When expanded, let the title and location wrap to their full text */
  .group.is-expanded .event-title,
  .group.is-expanded .event-loc {
    overflow: visible;
    white-space: normal;
    text-overflow: clip;
  }
</style>

<script>
  // One delegated listener handles every rail item on the page.
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest<HTMLButtonElement>("[data-event-expand]");
    if (!btn) return;

    const id = btn.getAttribute("aria-controls");
    const panel = id ? document.getElementById(id) : null;
    if (!panel) return;

    const willOpen = panel.hasAttribute("hidden");
    panel.toggleAttribute("hidden", !willOpen);
    btn.setAttribute("aria-expanded", String(willOpen));
    btn.closest(".group")?.classList.toggle("is-expanded", willOpen);
  });
</script>
