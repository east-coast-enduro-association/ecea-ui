/**
 * Self-hosted TinaCMS backend — Netlify Function.
 *
 * Exposed at /api/tina/* via the redirect in netlify.toml. The admin UI
 * (tina/config.tsx → contentApiUrlOverride) calls:
 *   - /api/tina/gql       (content queries/mutations)
 *   - /api/tina/auth/*    (username/password login)
 *
 * ⚠️ SPIKE — NOT YET VERIFIED ON A REAL DEPLOY.
 * `TinaNodeBackend` is an Express-style (req, res) handler, so we wrap it with
 * express + serverless-http to run inside a Netlify Function. The ONE thing
 * most likely to need adjustment on first deploy is the route/path shim below
 * (how the path after /api/tina is handed to TinaNodeBackend). If you'd rather
 * avoid the shim entirely, Vercel runs this handler natively — see SELFHOST.md.
 *
 * Requires deps (see SELFHOST.md): express@4 (v5's router/query changes break
 * this shim), serverless-http, @tinacms/datalayer, tinacms-authjs. And
 * `databaseClient` is generated by `npm run build:tina` into tina/__generated__/.
 */
import express from "express";
import serverless from "serverless-http";
import { TinaNodeBackend, LocalBackendAuthProvider } from "@tinacms/datalayer";
import { TinaAuthJSOptions, AuthJsBackendAuthProvider } from "tinacms-authjs";
import databaseClient from "../../tina/__generated__/databaseClient";

const isLocal = process.env.TINA_PUBLIC_IS_LOCAL === "true";

const tinaBackend = TinaNodeBackend({
  authProvider: isLocal
    ? LocalBackendAuthProvider()
    : AuthJsBackendAuthProvider({
        authOptions: TinaAuthJSOptions({
          databaseClient,
          secret: process.env.NEXTAUTH_SECRET as string,
        }),
      }),
  databaseClient,
});

const app = express();
app.use(express.json());

app.all("/api/tina/*", (req, res) => {
  // TinaNodeBackend derives its route from req.query.routes (the Next.js
  // [...routes] catch-all convention: path parts after /api/tina). Rebuild it
  // from the Express path. ⚠️ verify this on first deploy.
  const tail = req.path.replace(/^\/api\/tina\/?/, "");
  (req.query as Record<string, unknown>).routes = tail.split("/").filter(Boolean);
  return tinaBackend(req, res);
});

export const handler = serverless(app);
