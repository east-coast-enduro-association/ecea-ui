# ───────────────────────── Self-hosted TinaCMS ─────────────────────────
# Copy to `.env` for local dev. In production these are set in the host
# dashboard (Netlify/Vercel), NOT committed.

# Local dev uses the filesystem (no GitHub/Redis/auth needed). Set to "true"
# locally; the production backend sets it to "false".
TINA_PUBLIC_IS_LOCAL=true

# ── GitHub: where content is committed ──
# Fine-grained PAT (or GitHub App) scoped to the ecea-ui repo with
# "Contents: Read and write". This single token means editors do NOT need
# their own GitHub accounts.
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_OWNER=east-coast-enduro-association
GITHUB_REPO=ecea-ui
GITHUB_BRANCH=master

# ── Upstash Redis: the content index (from the Upstash console → REST API) ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Auth.js secret for the editor login (generate: openssl rand -base64 32) ──
NEXTAUTH_SECRET=
